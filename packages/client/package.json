{
  "name": "@nanoagent/client",
  "version": "0.1.0",
  "description": "Typed server-side client for the NanoAgent HTTP/SSE API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeyuyang8/nanoagent.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
